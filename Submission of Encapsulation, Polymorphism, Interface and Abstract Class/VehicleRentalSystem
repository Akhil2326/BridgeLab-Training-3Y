// Interface for insurable vehicles
interface Insurable {
    double calculateInsurance();
    String getInsuranceDetails();
}

// Abstract Vehicle class
abstract class Vehicle {
    private String vehicleNumber;
    private String type;
    private double rentalRate;  // rate per day

    public Vehicle(String vehicleNumber, String type, double rentalRate) {
        this.vehicleNumber = vehicleNumber;
        this.type = type;
        this.rentalRate = rentalRate;
    }

    // Getters and setters with encapsulation
    public String getVehicleNumber() {
        return vehicleNumber;
    }

    public void setVehicleNumber(String vehicleNumber) {
        this.vehicleNumber = vehicleNumber;
    }

    public String getType() {
        return type;
    }

    public void setType(String type) {
        this.type = type;
    }

    public double getRentalRate() {
        return rentalRate;
    }

    public void setRentalRate(double rentalRate) {
        if (rentalRate >= 0) {
            this.rentalRate = rentalRate;
        }
    }

    // Abstract method to calculate rental cost based on days
    public abstract double calculateRentalCost(int days);
}

// Car class (insurable)
class Car extends Vehicle implements Insurable {
    // Encapsulated insurance policy number
    private String insurancePolicyNumber;

    public Car(String vehicleNumber, double rentalRate, String insurancePolicyNumber) {
        super(vehicleNumber, "Car", rentalRate);
        this.insurancePolicyNumber = insurancePolicyNumber;
    }

    @Override
    public double calculateRentalCost(int days) {
        // Car rental cost with some fixed surcharge per day (e.g., 10%)
        return getRentalRate() * days * 1.10;
    }

    @Override
    public double calculateInsurance() {
        // Car insurance flat rate (e.g., $20 per day)
        return 20 * getRentalRate();  // Insurance cost proportional to rentalRate for simplicity
    }

    @Override
    public String getInsuranceDetails() {
        return "Car Insurance Policy#: " + maskPolicyNumber();
    }

    // Mask sensitive insurance policy number except last 4 digits
    private String maskPolicyNumber() {
        if (insurancePolicyNumber == null || insurancePolicyNumber.length() < 4) {
            return "****";
        }
        int length = insurancePolicyNumber.length();
        return "****" + insurancePolicyNumber.substring(length - 4);
    }
}

// Bike class (not insurable)
class Bike extends Vehicle {
    public Bike(String vehicleNumber, double rentalRate) {
        super(vehicleNumber, "Bike", rentalRate);
    }

    @Override
    public double calculateRentalCost(int days) {
        // Bike rental cost with no surcharge
        return getRentalRate() * days;
    }
}

// Truck class (insurable)
class Truck extends Vehicle implements Insurable {
    private String insurancePolicyNumber;

    public Truck(String vehicleNumber, double rentalRate, String insurancePolicyNumber) {
        super(vehicleNumber, "Truck", rentalRate);
        this.insurancePolicyNumber = insurancePolicyNumber;
    }

    @Override
    public double calculateRentalCost(int days) {
        // Truck rental cost with a 20% surcharge per day
        return getRentalRate() * days * 1.20;
    }

    @Override
    public double calculateInsurance() {
        // Truck insurance cost (e.g., $50 flat rate)
        return 50;
    }

    @Override
    public String getInsuranceDetails() {
        return "Truck Insurance Policy#: " + maskPolicyNumber();
    }

    private String maskPolicyNumber() {
        if (insurancePolicyNumber == null || insurancePolicyNumber.length() < 4) {
            return "****";
        }
        int length = insurancePolicyNumber.length();
        return "****" + insurancePolicyNumber.substring(length - 4);
    }
}

// Main class to demonstrate polymorphism and encapsulation
public class VehicleRentalSystem {
    public static void main(String[] args) {
        Vehicle[] vehicles = new Vehicle[] {
            new Car("CAR123", 100, "CARPOLICY123456"),
            new Bike("BIKE456", 40),
            new Truck("TRUCK789", 150, "TRUCKPOLICY987654")
        };

        int rentalDays = 5;

        for (Vehicle v : vehicles) {
            double rentalCost = v.calculateRentalCost(rentalDays);
            System.out.printf("Vehicle: %s (%s), Rental Cost for %d days: %.2f",
                    v.getVehicleNumber(), v.getType(), rentalDays, rentalCost);

            if (v instanceof Insurable) {
                Insurable ins = (Insurable) v;
                double insuranceCost = ins.calculateInsurance();
                System.out.printf(", Insurance Cost: %.2f, %s%n", insuranceCost, ins.getInsuranceDetails());
            } else {
                System.out.println(", No Insurance Available");
            }
        }
    }
}
